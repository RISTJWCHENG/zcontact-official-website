// Security headers for the zContact Official Website asset canister.
// Everything is served from this canister: no third-party scripts, styles,
// fonts, images or analytics, and the page makes no network requests.
[
  {
    "match": "**/*",
    "security_policy": "standard",
    // The custom CSP below is stricter than the standard policy.
    "disable_security_policy_warning": true,
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "Referrer-Policy": "no-referrer",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
      "X-Content-Type-Options": "nosniff",
      "Cross-Origin-Opener-Policy": "same-origin"
    },
    "allow_raw_access": false
  },
  {
    // The custom domains (dotfiles are skipped unless listed).
    "match": ".well-known",
    "ignore": false
  },
  {
    "match": "fonts/**/*",
    "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
  }
]
